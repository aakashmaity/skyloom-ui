{
  "name": "skyloom-ui",
  "version": "0.1.3",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.2.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^14.14.0",
    "prismjs": "^1.30.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.0",
    "three": "^0.187.0",
    "three-globe": "^2.45.6"
  },
  "description": "Theme-token-based React components, responsive layouts, paginated tables, and analytics charts.",
  "files": [
    "dist",
    "GUIDE.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "homepage": "https://github.com/aakashmaity/skyloom-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aakashmaity/skyloom-ui.git",
    "directory": "packages/sky-ui"
  },
  "bugs": {
    "url": "https://github.com/aakashmaity/skyloom-ui/issues"
  }
}
