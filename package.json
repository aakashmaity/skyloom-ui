{
  "name": "skyloom-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @skyloom/docs",
    "build": "npm run build -w @skyloom/docs",
    "start": "npm run start -w @skyloom/docs --",
    "typecheck": "npm run typecheck -w skyloom-ui && npm run typecheck -w @skyloom/docs",
    "test": "vitest run",
    "check:tokens": "tailwindcss -i ./tests/tailwind.css -o ./.checks/sky-ui.css && node scripts/check-tokens.mjs",
    "check": "npm run build -w skyloom-ui && npm run typecheck && npm run check:tokens && npm test",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
